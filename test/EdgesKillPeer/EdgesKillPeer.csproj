<Project Sdk="Microsoft.NET.Sdk">

  <!-- The process EdgesNatsKillTests kills: publishes a backlog of edge messages, or ingests them, until killed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DotnetCqrs\DotnetCqrs.csproj" />
    <ProjectReference Include="..\..\src\DotnetCqrs.Edges.Nats\DotnetCqrs.Edges.Nats.csproj" />
  </ItemGroup>

</Project>
