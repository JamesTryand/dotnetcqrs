<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>JamesTryand.DotnetCqrs.Crypto</PackageId>
    <Description>Crypto-shredding support for dotnetcqrs -- the Pii&lt;T&gt; wrapper, its fail-closed JSON envelope, and the HTTP client for the key-management facade. Generated deciders with field.pii values reference this.</Description>
  </PropertyGroup>

  <!-- BCL only (System.Net.Http.Json, System.Text.Json) plus the provider-neutral
       contract: this talks to platform/key-management-service's facade over plain
       HTTPS/JSON, no Vault SDK. The Abstractions reference exists for
       RevealRequiredException, the one type Pii<T> and DeciderRegistry must agree on. -->

  <ItemGroup>
    <ProjectReference Include="..\DotnetCqrs.Abstractions\DotnetCqrs.Abstractions.csproj" />
  </ItemGroup>

</Project>
