<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DotnetCqrs.Codegen.Cli</RootNamespace>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnetcqrs-codegen</ToolCommandName>
    <PackageId>JamesTryand.DotnetCqrs.Codegen.Cli</PackageId>
    <Description>Generates dotnetcqrs deciders/projections/reactors (and optionally a runnable host project) from an EventModeling document.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotnetCqrs.Codegen\DotnetCqrs.Codegen.csproj" />
  </ItemGroup>

</Project>
