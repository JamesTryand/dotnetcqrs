<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DotnetCqrs\DotnetCqrs.csproj" />
    <!-- For SubjectErasedException, which the gateway maps to 410. Crypto is BCL-only
         plus Abstractions, so this adds no third-party dependency to a host. -->
    <ProjectReference Include="..\DotnetCqrs.Crypto\DotnetCqrs.Crypto.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>JamesTryand.DotnetCqrs.Host</PackageId>
    <Description>ASP.NET Core command gateway for dotnetcqrs -- POST /{prefix}/{aggregate}/{aggregateId}/{command}, pluggable auth (bring your own AddJwtBearer/etc.) and file storage (IFileStore).</Description>
  </PropertyGroup>

  <!-- Lets this class library reference ASP.NET Core routing/hosting types
       (IEndpointRouteBuilder, HttpRequest, etc.) without being an executable
       web app itself: the standard shape for a reusable ASP.NET Core
       integration package. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
