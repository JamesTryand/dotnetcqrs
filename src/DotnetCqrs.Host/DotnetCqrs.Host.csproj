<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\DotnetCqrs\DotnetCqrs.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Lets this class library reference ASP.NET Core routing/hosting types
       (IEndpointRouteBuilder, HttpRequest, etc.) without being an executable
       web app itself: the standard shape for a reusable ASP.NET Core
       integration package. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
