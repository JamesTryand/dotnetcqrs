<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>JamesTryand.DotnetCqrs.Codegen</PackageId>
    <Description>Generates dotnetcqrs deciders, projections, reactors, and a runnable host project from an EventModeling document, plus scenario verification against the generated code.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JsonSchema.Net" Version="9.4.0" />
  </ItemGroup>

  <!-- Pinned copy of eventmodelschema's eventmodeling.schema.json (v3.1.1, eventmodelschema@f616eaf,
       copied 2026-09-24 from the local clone of lab/eventmodelschema): vendored rather than
       fetched at runtime, so validation works offline and deterministically. Update by
       re-fetching from that repo when a new schema version is needed. -->
  <ItemGroup>
    <EmbeddedResource Include="Schema\eventmodeling.schema.json" />
  </ItemGroup>

  <!-- The fixed scenario-verification harness (see its own header comment): copied
       verbatim into a scratch project by ScenarioVerifier, never compiled as part of
       this assembly itself: .txt so the C# compiler here ignores it, and
       EmbeddedResource so it ships inside DotnetCqrs.Codegen.dll rather than needing
       to be found on disk relative to wherever the assembly happens to run from.
       Named HarnessProgram.txt, NOT Harness.cs.txt: MSBuild's AssignCulture task
       treats a "Name.xx.ext" filename as a satellite resource for culture "xx" when
       "xx" is a recognized ISO language code: "cs" is Czech, so "Harness.cs.txt"
       silently vanished from the main assembly's manifest resources into culture
       handling instead of embedding normally. Confirmed via `dotnet msbuild
       -getItem:EmbeddedResource` (the item WAS recognized) plus
       Assembly.GetManifestResourceNames() (it wasn't there) before renaming. -->
  <ItemGroup>
    <EmbeddedResource Include="Verification\HarnessProgram.txt" />
  </ItemGroup>

</Project>
